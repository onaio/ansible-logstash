---
extends: default

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false

# Scenarios CI doesn't run
ignore: |
  molecule/centos7/
  molecule/centos8/
  molecule/debian10/
  molecule/debian8/
  molecule/debian9/
  molecule/fedora/
  molecule/ubuntu1604/
  molecule/ubuntu1804/
  molecule/ubuntu2004/
